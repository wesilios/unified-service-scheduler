            "description": "Guest checkout - no login required. Seeded Dealership id is the one created by the InitialCreate migration. Sends a fixed X-Correlation-Id and checks the middleware echoes it back verbatim."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has 4 appointment slots (30-min OIL_CHANGE = 2 slots x 2 resources)\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.slots.length).to.eql(4);",
                  "});",
                  "pm.test(\"X-Correlation-Id is echoed back verbatim\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(\"postman-demo-001\");",
                  "});"
